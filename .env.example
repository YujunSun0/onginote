# .env.local 로 복사해서 값을 채운다. .env.local 은 깃에 올라가지 않는다.

# Claude API 키 (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Supabase (대시보드 > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 말 것
SUPABASE_SECRET_KEY=sb_secret_...

# 사용할 모델 (적지 않으면 코드 기본값을 씁니다)
# ONGI_FREE_CHAT_MODEL  무료 요금제 캐릭터 답변 (기본: claude-haiku-5-5)
# ONGI_PLUS_CHAT_MODEL  Plus 요금제 캐릭터 답변 (기본: claude-haiku-5-5, 무료와 같음)
# ONGI_ROUTER_MODEL 모드 판단 (기본: claude-haiku-5-5)
# ONGI_LIGHT_MODEL  정리하기, 물어보기 (기본: claude-haiku-5-5)

# 요금제 한도 (적지 않으면 기본값. 전체 목록은 src/lib/plans.ts)
# ONGI_FREE_DAILY_USD=0.1           무료 1인 하루 한도 (달러)
# ONGI_PLUS_DAILY_USD=0.5           Plus 1인 하루 한도 (달러)
# ONGI_PLUS_PERIOD_USD=8            Plus 구독 기간(한 달) 한도 (달러)
# ONGI_GLOBAL_DAILY_BUDGET_USD=5    서비스 전체 하루 한도 기본값 (달러)
# ONGI_GLOBAL_PER_PLUS_USD=0.5      Plus 회원 한 명당 전체 한도에 더하는 금액

# 탈퇴한 이메일 해시용 비밀키 (서버 전용). 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ONGI_EMAIL_HASH_KEY=
# 탈퇴 후 같은 이메일로 재가입을 막는 기간 (일, 기본 30)
# ONGI_REJOIN_BLOCK_DAYS=30

# 토스페이먼츠 자동결제 (개발자센터 > API 키 > "API 개별 연동 키". 결제위젯 키(gck/gsk)는 자동결제에 못 씀)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
# 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 말 것
TOSS_SECRET_KEY=test_sk_...
# 자동 결제 스케줄러(/api/billing/renew) 비밀값. 만들기: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
