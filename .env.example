# Claude API 키를 여기에 붙여넣으세요 (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# 사용할 모델 (기본: claude-opus-5-5)
# 모드 판단만 저렴하게 하고 싶으면 ONGI_ROUTER_MODEL=claude-haiku-5-5
# ONGI_CHAT_MODEL=claude-opus-5-5
# ONGI_ROUTER_MODEL=claude-opus-5-5

# 하루 사용 한도 (달러, 기본 1). 화면에는 이 한도 대비 퍼센트로만 보입니다.
# ONGI_DAILY_BUDGET_USD=1
